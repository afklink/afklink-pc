{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AFKLink",
  "identifier": "com.afklink.agent",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "bun run --filter afklink-agent-ui dev",
    "beforeBuildCommand": "bun run --filter afklink-agent-ui build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AFKLink",
        "width": 400,
        "height": 600,
        "minWidth": 340,
        "minHeight": 480,
        "resizable": true,
        "visible": true,
        "backgroundColor": "#121214"
      },
      {
        "label": "pair-request",
        "title": "AFKLink",
        "width": 380,
        "height": 196,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "focus": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "backgroundColor": "#121214"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "AFKLink",
    "copyright": "© 2026 AFKLink",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.png"]
  }
}
