{
  "$id": "https://afklink.dev/schema/rest-agent-start-failure.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "reason": {
      "type": "string",
      "enum": [
        "webview2_missing"
      ]
    },
    "device_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "version": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^\\d{1,5}\\.\\d{1,5}\\.\\d{1,5}(-[0-9A-Za-z.-]{1,24})?$"
    },
    "channel": {
      "type": "string",
      "enum": [
        "dev",
        "release"
      ]
    },
    "commit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "os": {
      "type": "string",
      "maxLength": 24,
      "pattern": "^\\d{1,3}\\.\\d{1,3}\\.\\d{1,6}(\\.\\d{1,6})?$"
    },
    "detail_code": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-Za-z_.-]{1,32}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "reason",
    "device_id",
    "version",
    "channel",
    "os"
  ]
}
