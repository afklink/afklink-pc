{
  "$id": "https://afklink.dev/schema/server-to-agent.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "challenge"
        },
        "nonce": {
          "type": "string",
          "minLength": 44,
          "maxLength": 44
        }
      },
      "required": [
        "type",
        "nonce"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "agent_ready"
        },
        "protocol_version": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "min_supported_protocol": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "telegram_user_id": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "username": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "first_name": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 128
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "role": {
                "type": "string",
                "enum": [
                  "owner",
                  "guest"
                ]
              }
            },
            "required": [
              "telegram_user_id",
              "username",
              "first_name"
            ]
          }
        }
      },
      "required": [
        "type",
        "protocol_version",
        "min_supported_protocol",
        "bindings"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "pairing_code"
        },
        "code": {
          "type": "string",
          "pattern": "^\\d{6}$"
        },
        "expires_at": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "bot_username": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]{1,64}$"
        },
        "miniapp_short_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]{1,64}$"
        }
      },
      "required": [
        "type",
        "code",
        "expires_at"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "pair_request"
        },
        "request_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "telegram_user_id": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "username": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "first_name": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "expires_at": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "has_owner": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "request_id",
        "telegram_user_id",
        "username",
        "first_name",
        "expires_at"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "pair_cancelled"
        },
        "request_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "reason": {
          "type": "string",
          "enum": [
            "declined",
            "timeout",
            "cancelled",
            "agent_disconnected"
          ]
        }
      },
      "required": [
        "type",
        "request_id",
        "reason"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "binding_added"
        },
        "telegram_user_id": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "username": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "first_name": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "owner",
            "guest"
          ]
        },
        "via": {
          "type": "string",
          "enum": [
            "invite"
          ]
        }
      },
      "required": [
        "type",
        "telegram_user_id",
        "username",
        "first_name"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "binding_removed"
        },
        "telegram_user_id": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "telegram_user_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "owner_changed"
        },
        "telegram_user_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "telegram_user_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "owner_request_state"
        },
        "request_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "make_owner",
            "unbind_owner",
            "pc_allow"
          ]
        },
        "telegram_user_id": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "confirmed",
            "applied",
            "declined",
            "expired",
            "cancelled",
            "refused"
          ]
        },
        "expires_at": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string",
          "enum": [
            "not_bound",
            "already_owner",
            "not_owner",
            "busy",
            "rate_limited",
            "failed",
            "by_pc",
            "target_left",
            "owner_left",
            "by_requester"
          ]
        },
        "username": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "first_name": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "kind",
        "telegram_user_id",
        "state"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "session_request"
        },
        "session_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "telegram_user_id": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "username": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "turn": {
          "type": "object",
          "properties": {
            "urls": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 256
              }
            },
            "username": {
              "type": "string",
              "maxLength": 256
            },
            "credential": {
              "type": "string",
              "maxLength": 256
            }
          },
          "required": [
            "urls",
            "username",
            "credential"
          ]
        },
        "quality_profile": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 32
            },
            "v": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "id",
            "v"
          ],
          "additionalProperties": {}
        }
      },
      "required": [
        "type",
        "session_id",
        "telegram_user_id",
        "username",
        "turn"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "sdp"
        },
        "session_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "sdp_type": {
          "type": "string",
          "enum": [
            "offer",
            "answer"
          ]
        },
        "sdp": {
          "type": "string",
          "maxLength": 49152
        }
      },
      "required": [
        "type",
        "session_id",
        "sdp_type",
        "sdp"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ice"
        },
        "session_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "candidate": {
          "type": "object",
          "properties": {
            "candidate": {
              "type": "string",
              "maxLength": 1024
            },
            "sdpMid": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            },
            "sdpMLineIndex": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                {
                  "type": "null"
                }
              ]
            },
            "usernameFragment": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "candidate"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "session_id",
        "candidate"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "session_end"
        },
        "session_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "reason": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "type",
        "session_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ping"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "code": {
          "type": "string",
          "enum": [
            "bad_json",
            "bad_message",
            "message_too_large",
            "protocol_unsupported",
            "not_authenticated",
            "auth_timeout",
            "rate_limited",
            "already_hello",
            "invalid_pubkey",
            "pubkey_mismatch",
            "no_challenge",
            "bad_signature",
            "replaced",
            "unauthorized",
            "not_bound",
            "device_offline",
            "ticket_invalid",
            "unknown_session",
            "too_many_sessions",
            "invalid_code",
            "expired_code",
            "code_used",
            "not_found",
            "invalid_name",
            "origin_refused",
            "payload_too_large",
            "clock_skew",
            "nonce_reused",
            "digest_mismatch",
            "request_timeout",
            "service_unavailable",
            "beta_required",
            "account_blocked",
            "device_blocked",
            "internal"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "type",
        "code"
      ]
    }
  ]
}
