{
  "$id": "https://afklink.dev/schema/rest-diagnostics-agent-headers.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "x-afklink-device": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "x-afklink-timestamp": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,15}$"
    },
    "x-afklink-nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "x-afklink-content-sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "x-afklink-meta": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12288,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "x-afklink-signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  },
  "required": [
    "x-afklink-device",
    "x-afklink-timestamp",
    "x-afklink-nonce",
    "x-afklink-content-sha256",
    "x-afklink-meta",
    "x-afklink-signature"
  ]
}
