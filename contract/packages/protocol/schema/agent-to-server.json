                      "type": "number",
                      "minimum": 0,
                      "maximum": 60000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "input": {
                  "type": "object",
                  "properties": {
                    "abs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "rel": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "buttons": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "keys": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
