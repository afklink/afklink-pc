            "candidate"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "session_id",
        "candidate"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "session_end"
