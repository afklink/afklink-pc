{
  "$id": "https://afklink.dev/schema/agent-to-server.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "agent_hello"
        },
        "protocol_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "device_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "pubkey": {
          "type": "string",
          "minLength": 44,
          "maxLength": 44
        },
        "build": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "maxLength": 32,
              "pattern": "^\\d{1,5}\\.\\d{1,5}\\.\\d{1,5}(-[0-9A-Za-z.-]{1,24})?$"
            },
            "commit": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{7,40}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "channel": {
              "type": "string",
              "enum": [
                "dev",
                "release"
              ]
            },
            "dirty": {
              "type": "boolean"
            }
          },
          "required": [
            "version",
            "channel"
          ]
        },
        "boot_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "last_exit": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "app_exit",
                "update_exit",
                "panic",
                "crash",
                "os_shutdown",
                "unknown"
              ]
            },
            "at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4102444800000
            }
          },
          "required": [
            "kind"
          ]
        },
        "hw": {
          "type": "object",
          "properties": {
            "hash": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "vm": {
              "type": "boolean"
            },
            "parts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          },
          "required": [
            "hash",
            "vm",
            "parts"
          ]
        }
      },
      "required": [
        "type",
        "protocol_version",
        "device_id",
        "pubkey"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "agent_auth"
        },
        "signature": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88
        }
      },
      "required": [
        "type",
        "signature"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "request_pairing"
        }
      },
      "required": [
